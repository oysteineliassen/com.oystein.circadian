{
  "id": "com.oystein.circadian",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Circadian Lighting",
    "no": "Døgnrytmelys"
  },
  "description": {
    "en": "Automatically adjusts the color temperature of your lights through the day (sun-based or fixed schedule).",
    "no": "Justerer automatisk fargetemperaturen på lysene dine gjennom dagen (basert på sol eller fast tidsplan)."
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Øystein"
  },
  "api": {
    "getDevices": {
      "method": "GET",
      "path": "/devices"
    },
    "getConfig": {
      "method": "GET",
      "path": "/config"
    },
    "setConfig": {
      "method": "POST",
      "path": "/config"
    },
    "applyNow": {
      "method": "POST",
      "path": "/apply"
    },
    "resumeDevice": {
      "method": "POST",
      "path": "/resume"
    },
    "resumeAll": {
      "method": "POST",
      "path": "/resume-all"
    },
    "simulateGroup": {
      "method": "POST",
      "path": "/simulate"
    },
    "stopSimulation": {
      "method": "POST",
      "path": "/simulate-stop"
    },
    "getSimulationStatus": {
      "method": "GET",
      "path": "/simulate-status"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "light-locked",
        "title": {
          "en": "A light was locked after a manual adjustment",
          "no": "Et lys ble låst etter manuell justering"
        },
        "hint": {
          "en": "Runs when you change the brightness or colour of a light yourself, and the app stops controlling it.",
          "no": "Kjører når du endrer lysstyrke eller farge på et lys selv, og appen slutter å styre det."
        },
        "tokens": [
          {
            "name": "light",
            "type": "string",
            "title": {
              "en": "Light",
              "no": "Lys"
            },
            "example": {
              "en": "Living room lamp",
              "no": "Stuelampe"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is-locked",
        "title": {
          "en": "Light !{{is|is not}} locked",
          "no": "Lyset !{{er|er ikke}} låst"
        },
        "titleFormatted": {
          "en": "[[device]] !{{is|is not}} locked",
          "no": "[[device]] !{{er|er ikke}} låst"
        },
        "hint": {
          "en": "Locked means the app has stopped controlling the light, after a manual adjustment or a pause.",
          "no": "Låst betyr at appen har sluttet å styre lyset, etter manuell justering eller pause."
        },
        "args": [
          {
            "name": "device",
            "type": "autocomplete",
            "placeholder": {
              "en": "Choose a light",
              "no": "Velg et lys"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "resume-circadian",
        "title": {
          "en": "Resume circadian lighting",
          "no": "Aktiver døgnrytmestyring (alle lys)"
        }
      },
      {
        "id": "resume-circadian-device",
        "title": {
          "en": "Resume circadian lighting for a light",
          "no": "Aktiver døgnrytmestyring for ett lys"
        },
        "titleFormatted": {
          "en": "Resume circadian lighting for [[device]]",
          "no": "Aktiver døgnrytmestyring for [[device]]"
        },
        "args": [
          {
            "name": "device",
            "type": "autocomplete",
            "placeholder": {
              "en": "Choose a light",
              "no": "Velg et lys"
            }
          }
        ]
      },
      {
        "id": "turn-on-group",
        "title": {
          "en": "Turn on a group and start circadian lighting",
          "no": "Slå på en gruppe og start døgnrytme"
        },
        "titleFormatted": {
          "en": "Turn on [[group]] and start circadian lighting",
          "no": "Slå på [[group]] og start døgnrytme"
        },
        "hint": {
          "en": "Switches on every light in the group, also ones that are off, at the schedule's current values, and unlocks them.",
          "no": "Slår på alle lysene i gruppen, også de som er av, med verdiene døgnrytmen har akkurat nå, og låser dem opp."
        },
        "args": [
          {
            "name": "group",
            "type": "autocomplete",
            "placeholder": {
              "en": "Choose a group",
              "no": "Velg en gruppe"
            }
          }
        ]
      },
      {
        "id": "pause-until-off",
        "title": {
          "en": "Pause circadian lighting until switched off",
          "no": "Sett døgnrytme på pause til lyset slås av"
        },
        "titleFormatted": {
          "en": "Pause circadian lighting for [[target]] until switched off",
          "no": "Sett døgnrytme på pause for [[target]] til det slås av"
        },
        "hint": {
          "en": "The app leaves the light (or every light in the group) alone until it is next switched off. Useful for motion-triggered night lights.",
          "no": "Appen lar lyset (eller alle lysene i gruppen) være i fred til neste gang det slås av. Nyttig for nattlys som styres av bevegelse."
        },
        "args": [
          {
            "name": "target",
            "type": "autocomplete",
            "placeholder": {
              "en": "Choose a light or group",
              "no": "Velg et lys eller en gruppe"
            }
          }
        ]
      },
      {
        "id": "set-group-enabled",
        "title": {
          "en": "Switch circadian lighting on or off for a group",
          "no": "Skru døgnrytme av eller på for en gruppe"
        },
        "titleFormatted": {
          "en": "Switch circadian lighting [[state]] for [[group]]",
          "no": "Skru døgnrytme [[state]] for [[group]]"
        },
        "hint": {
          "en": "While off, the app leaves the group's lights alone, e.g. for a movie or guests.",
          "no": "Mens den er av, lar appen lysene i gruppen være i fred, f.eks. ved film eller gjester."
        },
        "args": [
          {
            "name": "state",
            "type": "dropdown",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          },
          {
            "name": "group",
            "type": "autocomplete",
            "placeholder": {
              "en": "Choose a group",
              "no": "Velg en gruppe"
            }
          }
        ]
      }
    ]
  },
  "brandColor": "#F28C28"
}
